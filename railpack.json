{
  "$schema": "https://schema.railpack.com",
  "packages": {
    "go": "1.26.2",
    "python": "3.12",
    "uv": "latest"
  },
  "steps": {
    "build": {
      "commands": [
        "uv sync",
        "cp scheduler/config.railway.json scheduler/config.json",
        "cd scheduler && go build -o ../go-trader ."
      ]
    }
  },
  "deploy": {
    "startCommand": "sh -c './go-trader --config scheduler/config.railway.json --status-port ${PORT:-8080}'"
  }
}
